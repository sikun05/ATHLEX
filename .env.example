# ─── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: MP4/WebM for the hero background (falls back to the hero photo)
NEXT_PUBLIC_HERO_VIDEO_URL=

# ─── Supabase ─────────────────────────────────────────────────────────
# When these are missing the app runs in DEMO MODE (in-memory data + demo logins).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for payment activation, webhooks and cron jobs. NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Razorpay ─────────────────────────────────────────────────────────
# When missing, checkout uses a simulated (demo) gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Security ─────────────────────────────────────────────────────────
# HMAC secret for QR attendance tokens and demo sessions (min 32 chars).
APP_SECRET=
# Bearer token Vercel Cron sends to /api/cron/*
CRON_SECRET=
# Allow demo mode in production builds (for staging/previews only)
DEMO_MODE=false

# ─── Notifications (all optional; messages are logged when unset) ─────
ADMIN_NOTIFY_EMAIL=
EMAIL_FROM="ATHLEX <hello@athlex.fit>"
RESEND_API_KEY=
# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_NOTIFY_WHATSAPP=
# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
